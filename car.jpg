
/* ==========================================
   MECHANICAL WORLD — CAR DATABASE
   موسوعة السيارات والهندسة
========================================== */

(() => {
  "use strict";

  const cars = [
    {
      id: "bmw-m5",
      brand: "BMW",
      name: "BMW M5",
      type: "Luxury Performance Sedan",
      year: "2025",
      power: "717 HP",
      engine: "4.4L V8 Twin-Turbo Hybrid",
      speed: "305 km/h",
      acceleration: "3.5 seconds",
      drive: "M xDrive AWD",
      image: "https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=1200&q=85",
      description: "سيارة رياضية فاخرة تجمع بين القوة والتكنولوجيا والهندسة الألمانية المتقدمة."
    },
    {
      id: "mercedes-amg",
      brand: "Mercedes-Benz",
      name: "Mercedes-AMG GT",
      type: "Sports Car",
      year: "2025",
      power: "585 HP",
      engine: "4.0L V8 Biturbo",
      speed: "315 km/h",
      acceleration: "3.2 seconds",
      drive: "AWD",
      image: "https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1200&q=85",
      description: "سيارة رياضية عالية الأداء تتميز بالديناميكية الهوائية والتوازن."
    },
    {
      id: "porsche-911",
      brand: "Porsche",
      name: "Porsche 911",
      type: "Sports Car",
      year: "2025",
      power: "388 HP",
      engine: "3.0L Flat-Six Twin-Turbo",
      speed: "295 km/h",
      acceleration: "4.1 seconds",
      drive: "RWD",
      image: "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=85",
      description: "أيقونة هندسية تعتمد على محرك خلفي وتصميم رياضي متوازن."
    },
    {
      id: "audi-rs7",
      brand: "Audi",
      name: "Audi RS7",
      type: "Sportback",
      year: "2025",
      power: "621 HP",
      engine: "4.0L V8 Twin-Turbo",
      speed: "305 km/h",
      acceleration: "3.3 seconds",
      drive: "quattro AWD",
      image: "https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?auto=format&fit=crop&w=1200&q=85",
      description: "مزيج بين الأداء الرياضي والراحة والتقنيات الذكية."
    },
    {
      id: "ferrari-488",
      brand: "Ferrari",
      name: "Ferrari 488",
      type: "Supercar",
      year: "2020",
      power: "670 HP",
      engine: "3.9L V8 Twin-Turbo",
      speed: "330 km/h",
      acceleration: "3.0 seconds",
      drive: "RWD",
      image: "https://images.unsplash.com/photo-1592198084033-aade902d1aae?auto=format&fit=crop&w=1200&q=85",
      description: "سيارة خارقة تجمع بين الأداء العالي والديناميكية الهوائية."
    },
    {
      id: "lamborghini",
      brand: "Lamborghini",
      name: "Lamborghini Huracán",
      type: "Supercar",
      year: "2024",
      power: "640 HP",
      engine: "5.2L Naturally Aspirated V10",
      speed: "325 km/h",
      acceleration: "2.9 seconds",
      drive: "AWD",
      image: "https://images.unsplash.com/photo-1511919884226-fd3cad34687c?auto=format&fit=crop&w=1200&q=85",
      description: "محرك V10 قوي وصوت مميز وهيكل مصمم لتحقيق أداء رياضي استثنائي."
    }
  ];

  const root = document.querySelector("#car-section");

  if (!root) {
    console.warn("أضيفي عنصرًا يحمل id='car-section' في index.html لعرض موسوعة السيارات.");
    window.CAR_DATABASE = cars;
    return;
  }

  window.CAR_DATABASE = cars;

  root.innerHTML = `
    <section class="car-library">
      <div class="car-library-heading">
        <span>THE AUTOMOTIVE COLLECTION</span>
        <h2>عالم <strong>السيارات</strong></h2>
        <p>
          اكتشفي عالم المحركات والأداء والهندسة من خلال مجموعة
          من أشهر السيارات الرياضية والفاخرة.
        </p>
      </div>

      <div class="car-filters">
        <input
          type="search"
          id="car-search"
          placeholder="ابحثي عن سيارة أو علامة تجارية..."
          aria-label="البحث عن سيارة"
        >

        <select id="car-filter" aria-label="تصفية السيارات">
          <option value="all">جميع السيارات</option>
          <option value="Sports Car">السيارات الرياضية</option>
          <option value="Supercar">السيارات الخارقة</option>
          <option value="Luxury Performance Sedan">السيدان الفاخرة</option>
          <option value="Sportback">سبورت باك</option>
        </select>
      </div>

      <div class="car-grid" id="car-grid"></div>

      <div class="car-modal" id="car-modal" hidden>
        <div class="car-modal-content">
          <button class="car-modal-close" aria-label="إغلاق">×</button>
          <div id="car-modal-body"></div>
        </div>
      </div>
    </section>
  `;

  const grid = root.querySelector("#car-grid");
  const search = root.querySelector("#car-search");
  const filter = root.querySelector("#car-filter");
  const modal = root.querySelector("#car-modal");
  const modalBody = root.querySelector("#car-modal-body");

  const escapeHTML = value => String(value ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[c]);

  function renderCars() {
    const query = search.value.trim().toLowerCase();
    const selectedType = filter.value;

    const filtered = cars.filter(car => {
      const matchesSearch =
        `${car.brand} ${car.name} ${car.engine}`.toLowerCase().includes(query);

      const matchesType =
        selectedType === "all" || car.type === selectedType;

      return matchesSearch && matchesType;
    });

    if (!filtered.length) {
      grid.innerHTML = `<p class="car-empty">لم يتم العثور على سيارة مطابقة.</p>`;
      return;
    }

    grid.innerHTML = filtered.map(car => `
      <article class="car-card">
        <div class="car-card-image">
          <img src="${escapeHTML(car.image)}"
               alt="${escapeHTML(car.name)}"
               loading="lazy">
          <span>${escapeHTML(car.brand)}</span>
        </div>

        <div class="car-card-info">
          <small>${escapeHTML(car.type)}</small>
          <h3>${escapeHTML(car.name)}</h3>
          <div class="car-card-specs">
            <span>⚡ ${escapeHTML(car.power)}</span>
            <span>🏎 ${escapeHTML(car.speed)}</span>
          </div>
          <button type="button" data-car="${escapeHTML(car.id)}">
            اكتشف التفاصيل <span>←</span>
          </button>
        </div>
      </article>
    `).join("");
  }

  function showCar(id) {
    const car = cars.find(item => item.id === id);
    if (!car) return;

    modalBody.innerHTML = `
      <img class="car-modal-image"
           src="${escapeHTML(car.image)}"
           alt="${escapeHTML(car.name)}">

      <div class="car-modal-details">
        <span class="car-modal-brand">${escapeHTML(car.brand)}</span>
        <h2>${escapeHTML(car.name)}</h2>
        <p>${escapeHTML(car.description)}</p>

        <h3>المواصفات التقنية</h3>

        <div class="car-spec-grid">
          <div><small>سنة الصنع</small><strong>${escapeHTML(car.year)}</strong></div>
          <div><small>القوة</small><strong>${escapeHTML(car.power)}</strong></div>
          <div><small>المحرك</small><strong>${escapeHTML(car.engine)}</strong></div>
          <div><small>السرعة القصوى</small><strong>${escapeHTML(car.speed)}</strong></div>
          <div><small>التسارع 0–100</small><strong>${escapeHTML(car.acceleration)}</strong></div>
          <div><small>نظام الدفع</small><strong>${escapeHTML(car.drive)}</strong></div>
        </div>
      </div>
    `;

    modal.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = "";
  }

  search.addEventListener("input", renderCars);
  filter.addEventListener("change", renderCars);

  grid.addEventListener("click", event => {
    const button = event.target.closest("[data-car]");
    if (button) showCar(button.dataset.car);
  });

  modal.querySelector(".car-modal-close")
    .addEventListener("click", closeModal);

  modal.addEventListener("click", event => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && !modal.hidden) closeModal();
  });

  const style = document.createElement("style");

  style.textContent = `
    .car-library {
      direction: rtl;
      padding: 70px 5%;
      background: #0b0b0b;
      color: #fff;
    }

    .car-library-heading {
      max-width: 750px;
      margin: 0 auto 40px;
      text-align: center;
    }

    .car-library-heading > span {
      color: #c5a45e;
      letter-spacing: 3px;
      font-size: 12px;
    }

    .car-library-heading h2 {
      font-size: clamp(30px, 5vw, 48px);
      margin: 15px 0;
    }

    .car-library-heading h2 strong {
      color: #d5b36a;
    }

    .car-library-heading p {
      color: #aaa;
      line-height: 2;
    }

    .car-filters {
      display: flex;
      gap: 12px;
      max-width: 850px;
      margin: 35px auto;
    }

    .car-filters input,
    .car-filters select {
      min-width: 0;
      flex: 1;
      padding: 14px;
      background: #171717;
      color: white;
      border: 1px solid #373737;
      border-radius: 7px;
      outline: none;
    }

    .car-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 23px;
    }

    .car-card {
      background: #151515;
      border: 1px solid #292929;
      border-radius: 12px;
      overflow: hidden;
      transition: .3s;
    }

    .car-card:hover {
      transform: translateY(-7px);
      border-color: #b8954d;
    }

    .car-card-image {
      height: 190px;
      position: relative;
      background: #222;
    }

    .car-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .car-card-image span {
      position: absolute;
      top: 13px;
      right: 13px;
      padding: 6px 11px;
      color: #111;
      background: #d5b36a;
      border-radius: 4px;
      font-size: 11px;
      font-weight: bold;
    }

    .car-card-info {
      padding: 20px;
    }

    .car-card-info small {
      color: #c5a45e;
    }

    .car-card-info h3 {
      font-size: 21px;
      margin: 10px 0 18px;
    }

    .car-card-specs {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      color: #bbb;
      font-size: 13px;
    }

    .car-card-info button {
      width: 100%;
      margin-top: 22px;
      padding: 12px;
      color: #d5b36a;
      background: transparent;
      border: 1px solid #b8954d;
      border-radius: 5px;
      cursor: pointer;
    }

    .car-card-info button:hover {
      background: #b8954d;
      color: #111;
    }

    .car-empty {
      grid-column: 1/-1;
      text-align: center;
      color: #aaa;
      padding: 35px;
    }

    .car-modal[hidden] {
      display: none !important;
    }

    .car-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: grid;
      place-items: center;
      padding: 18px;
      background: rgba(0,0,0,.88);
      overflow-y: auto;
    }

    .car-modal-content {
      position: relative;
      width: min(850px, 100%);
      max-height: 92vh;
      overflow-y: auto;
      background: #151515;
      border: 1px solid #b8954d;
      border-radius: 12px;
    }

    .car-modal-close {
      position: absolute;
      z-index: 2;
      top: 12px;
      left: 12px;
      width: 38px;
      height: 38px;
      border: 0;
      border-radius: 50%;
      background: #d5b36a;
      color: #111;
      font-size: 25px;
      cursor: pointer;
    }

    .car-modal-image {
      width: 100%;
      max-height: 330px;
      object-fit: cover;
    }

    .car-modal-details {
      padding: 25px;
    }

    .car-modal-brand {
      color: #d5b36a;
    }

    .car-modal-details h2 {
      font-size: 30px;
      margin: 10px 0;
    }

    .car-modal-details p {
      color: #bbb;
      line-height: 2;
    }

    .car-modal-details h3 {
      color: #d5b36a;
      margin: 25px 0 15px;
    }

    .car-spec-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .car-spec-grid div {
      padding: 15px;
      background: #202020;
      border-radius: 6px;
      overflow-wrap: anywhere;
    }

    .car-spec-grid small,
    .car-spec-grid strong {
      display: block;
    }

    .car-spec-grid small {
      color: #aaa;
      margin-bottom: 8px;
    }

    .car-spec-grid strong {
      color: #e1c47d;
      font-size: 14px;
    }

    @media(max-width:600px) {
      .car-filters {
        flex-direction: column;
      }

      .car-spec-grid {
        grid-template-columns: 1fr;
      }

      .car-library {
        padding: 45px 5%;
      }
    }
  `;

  document.head.appendChild(style);
  renderCars();

  console.log("MECHANICAL WORLD: Car Library loaded.");
})();
